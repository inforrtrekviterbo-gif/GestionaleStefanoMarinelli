# --- Supabase Postgres (dati) ---
# Connection string. In locale/dev usa un PROGETTO SUPABASE SEPARATO da quello di
# produzione, cosi' localhost non tocca mai i dati veri.
# Supabase > Project Settings > Database > Connection string (URI).
# Per Vercel/serverless usa il pooler in modalita' "Transaction" (porta 6543).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# --- Supabase Auth + Storage lato server (segreti) ---
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # solo lato server, MAI nel client
SUPABASE_STORAGE_BUCKET="product-photos"         # bucket foto prodotti (ex R2)

# --- Supabase Auth lato client (pubbliche, esposte al browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Gli account di accesso vanno creati in Supabase Auth con queste email:
#   admin@gestionale.local  ->  amministratore (entrambi i negozi)
#   viterbo@gestionale.local  ->  cassa Viterbo
#   gran-sasso@gestionale.local  ->  cassa Gran Sasso
# (mappa in lib/user-profiles.ts; il login nell'app usa lo username, non l'email)
